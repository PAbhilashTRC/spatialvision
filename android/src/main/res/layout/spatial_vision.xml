<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="com.wsp.plugins.spatialvision.helloar.HelloArActivity">

    <Button
        android:id="@+id/close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/colorAccent"
        android:text="@string/close"/>

    <android.opengl.GLSurfaceView
        android:id="@+id/surfaceview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <com.wsp.plugins.spatialvision.helloar.ReticleOverlayView
        android:id="@+id/reticle_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <ImageButton
        android:id="@+id/settings_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_margin="25dp"
        android:contentDescription="Settings"
        android:src="@drawable/ic_settings"
        android:background="@android:color/transparent"/>

    <SeekBar
        android:id="@+id/radius_slider"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/settings_button"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:max="50"
        android:progress="1"
        android:background="@android:color/transparent"/>

    <!-- Measurement Control Panel - Simplified -->
    <LinearLayout
        android:id="@+id/measurement_control_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:background="@drawable/anchor_panel_background"
        android:padding="12dp">

        <!-- Add Point Button (Main Action) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="16dp">

            <ImageButton
                android:id="@+id/btn_add_point"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/add_button_background"
                android:src="@drawable/ic_add_point"
                android:contentDescription="Add Measurement Point"
                app:tint="@android:color/white"
                android:padding="14dp"/>

            <TextView
                android:id="@+id/btn_add_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Point"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Reset Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="16dp">

            <ImageButton
                android:id="@+id/btn_reset"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/anchor_button_background"
                android:src="@drawable/ic_reset"
                android:contentDescription="Reset All"
                app:tint="@android:color/white"
                android:padding="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Mode Toggle (Auto/Manual) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="16dp">

            <ImageButton
                android:id="@+id/btn_toggle_mode"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/anchor_button_background"
                android:src="@drawable/ic_auto_mode"
                android:contentDescription="Toggle Mode"
                app:tint="@android:color/white"
                android:padding="10dp"/>

            <TextView
                android:id="@+id/mode_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Capture Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_capture"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/capture_button_background"
                android:src="@android:drawable/ic_menu_camera"
                android:contentDescription="Capture"
                app:tint="@android:color/white"
                android:padding="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Capture"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Measurement Info Panel -->
    <LinearLayout
        android:id="@+id/measurement_info_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp"
        android:padding="12dp"
        android:background="#CC000000"
        android:visibility="gone">

        <TextView
            android:id="@+id/points_count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Points: 0"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/measurements_count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Measurements: 0"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="4sp"/>

        <TextView
            android:id="@+id/total_distance_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total: 0.00 m"
            android:textColor="#FF9800"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="4sp"/>

    </LinearLayout>

    <!-- Last Measurement Toast Panel -->
    <LinearLayout
        android:id="@+id/last_measurement_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="100dp"
        android:padding="8dp"
        android:background="#DD000000"
        android:visibility="gone">

        <TextView
            android:id="@+id/last_measurement_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last: --"
            android:textColor="#4CAF50"
            android:textSize="12sp"
            android:gravity="center"/>

    </LinearLayout>

</RelativeLayout>