<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
tools:context="com.wsp.plugins.spatialvision.helloar.HelloArActivity">

<Button
    android:id="@+id/close_button"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/colorAccent"
    android:text="@string/close"/>

<android.opengl.GLSurfaceView
    android:id="@+id/surfaceview"
    android:layout_width="match_parent"
    android:layout_height="match_parent"/>

<ImageButton
    android:id="@+id/settings_button"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentEnd="true"
    android:layout_alignParentTop="true"
    android:layout_margin="25dp"
    android:contentDescription="TODO"
    android:src="@drawable/ic_settings"
    android:background="@android:color/transparent"/>

    <SeekBar
        android:id="@+id/radius_slider"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/settings_button"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:max="200"
        android:progress="10"
        android:background="@android:color/transparent"/>

<!-- Distance Overlay -->
<LinearLayout
    android:id="@+id/distance_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_alignParentBottom="true"
    android:layout_centerHorizontal="true"
    android:layout_margin="16dp"
    android:padding="12dp"
    android:background="#66000000">

    <TextView
        android:id="@+id/distance_between_objects"
        android:text="@string/obj1_to_obj2"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"/>

<!--    <TextView-->
<!--        android:id="@+id/distance_cam_obj1"-->
<!--        android:text="@string/cam_to_obj1"-->
<!--        android:textColor="#FFFFFF"-->
<!--        android:textSize="16sp"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_width="wrap_content"/>-->

<!--    <TextView-->
<!--        android:id="@+id/distance_cam_obj2"-->
<!--        android:text="@string/cam_to_obj2"-->
<!--        android:textColor="#FFFFFF"-->
<!--        android:textSize="16sp"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_width="wrap_content"/>-->
        <TextView
            android:id="@+id/depth_confidence"
            android:text="@string/depth_confidence"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"/>

</LinearLayout>

</RelativeLayout>
